# ABOUTME: Global git identity, branch/push defaults and git-lfs filter wiring (~/.gitconfig)
# ABOUTME: Email uses the GitHub noreply alias; the LFS filters require `brew install git-lfs`

[user]
	email = 4226595+ilmeskio@users.noreply.github.com
	name = Gabriele Consiglio
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[branch]
	# Only inherit the upstream when the new branch has the same name as the
	# remote one, so `git switch -c x origin/main` no longer tracks origin/main
	autoSetupMerge = simple
[push]
	# First `git push` creates the remote branch with the same name, no -u needed
	autoSetupRemote = true
{{ if lookPath "gh" -}}
[credential "https://github.com"]
	helper =
	helper = !{{ lookPath "gh" }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ lookPath "gh" }} auth git-credential
{{ end -}}
