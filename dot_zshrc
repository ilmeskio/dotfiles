# ABOUTME: Zsh interactive shell config — oh-my-zsh + plugins + PATH (brew/bun/uv) + direnv
# ABOUTME: Sourced for every interactive zsh; expects ~/.oh-my-zsh (bootstrapped by run_onchange_install-omz-plugins)

# Path to oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

# Plugins. Built-in plugins live in $ZSH/plugins, custom ones in $ZSH_CUSTOM/plugins.
# zsh-syntax-highlighting must be the LAST plugin loaded.
plugins=(
  git 1password
  npm yarn
  docker docker-compose
  gh gcloud brew
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# === User configuration ===

# Homebrew
export PATH="/opt/homebrew/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# mise (multi-runtime version manager) — successor to asdf; binary installed by Brewfile.
# Owns Node: the global version in ~/.config/mise/config.toml, a project's from its
# .nvmrc or mise.toml. Also the versions a project pins (e.g. OpenTofu in its mise.toml).
eval "$(mise activate zsh)"

# mysql-client
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

# libpq (postgres client)
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# Local user binaries
export PATH="$HOME/.local/bin:$PATH"

# Homebrew Ruby gems (e.g. kamal) — system Ruby is too old for these
export PATH="/opt/homebrew/lib/ruby/gems/4.0.0/bin:$PATH"

# ai-profile shims (claude, codex → ai-profile) come first: the agent starts
# with the folder's profile. Last PATH change, so nothing goes before them.
export PATH="$HOME/.local/share/ai-profiles/shims:$PATH"

# uv / Python env (created by `uv` installer)
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# direnv — auto-load .envrc per directory (run `direnv allow` once per project)
eval "$(direnv hook zsh)"

# chezmoi — warn when a managed file in home has drifted from the source of
# truth (~/.local/share/chezmoi). Silent when everything is in sync. Fix with
# `chezmoi diff <target>` then `chezmoi edit --apply <target>`; never a bare
# `chezmoi apply`, which overwrites the home version.
if command -v chezmoi >/dev/null 2>&1; then
  # .claude/settings.json diverges on purpose: the source is a sanitised
  # template (the dotfiles repo is public), the local file carries org data.
  _chezmoi_drift=$(chezmoi status 2>/dev/null | grep -v '\.claude/settings\.json$')
  if [[ -n $_chezmoi_drift ]]; then
    print -P "%F{yellow}chezmoi: drift rispetto alla sorgente%f"
    print -r -- "$_chezmoi_drift"
  fi
  unset _chezmoi_drift
fi

# 2026-09-22 Set Up Your Mac — interactive shell
if type brew >/dev/null 2>&1; then
  FPATH="$(brew --prefix)/share/zsh/site-functions:$FPATH"
fi
autoload -Uz compinit && compinit
[ -f "$HOME/.env" ] && set -a && source "$HOME/.env" && set +a

